# Behind Caddy the request reaches nginx over plain HTTP; keep the scheme Caddy reports.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8081;
    root /usr/share/nginx/html;
    index index.html;

    # PDF.js ships ES modules as .mjs; browsers refuse them without a JS MIME type.
    location ~ \.mjs$ {
        types {}
        default_type text/javascript;
    }

    # The API is served on the same origin; ${BACKEND_URL} is filled in at container start.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location = /actuator/health {
        proxy_pass ${BACKEND_URL};
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
