# Backend the Vite dev server (npm run dev / preview) proxies /api and /actuator to.
BACKEND_URL=http://localhost:8080

# Leave empty to call the API on the same origin (dev proxy, nginx in Docker).
# Set it only when the frontend is hosted apart from the backend, e.g. GitHub Pages;
# that origin must then be listed in the backend's CORS_ALLOWED_ORIGINS.
VITE_API_URL=
