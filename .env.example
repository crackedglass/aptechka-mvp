# Copy to .env and change the secrets before running `docker compose up --build`.
POSTGRES_DB=aptechka
POSTGRES_USER=aptechka
POSTGRES_PASSWORD=change-me

# Accounts are created in the app (POST /api/auth/register); the API uses HTTP Basic with them.
# Time zone of the person receiving care: dose times are local wall-clock times.
APP_TIMEZONE=Europe/Moscow

# The frontend's nginx proxies /api to the backend, so the browser stays on one origin.
# CORS matters only when the frontend is hosted elsewhere (e.g. GitHub Pages):
# list that origin here and set VITE_API_URL to the backend's public URL, then rebuild.
CORS_ALLOWED_ORIGINS=http://localhost:8765,http://127.0.0.1:8765
VITE_API_URL=
